[Unit]
Description=Cyber Chief Pathfinder (development)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pathfinder
Group=pathfinder
WorkingDirectory=/opt/pathfinder
EnvironmentFile=/etc/pathfinder.env
ExecStart=/opt/pathfinder/.venv/bin/pathfinder --state-dir /var/lib/pathfinder
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pathfinder
RestrictSUIDSGID=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
